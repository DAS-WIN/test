<UserControl x:Class="SrbMinerMonitor.App.Views.EventsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button Content="匯出紀錄" Command="{Binding ExportCommand}" DockPanel.Dock="Right"/><ComboBox ItemsSource="{Binding EventFilters}" SelectedItem="{Binding EventFilter}" DockPanel.Dock="Right" Width="130" Margin="0,0,12,0"/><TextBlock Text="事件紀錄" FontSize="23" FontWeight="SemiBold"/></DockPanel>
  <TextBlock Grid.Row="1" Text="僅顯示分享成功 Accepted、失敗 Rejected 與逾時 Timeout · 保留最近 2000 筆，顯示與匯出目前篩選的最近 500 筆" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
  <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0"><DataGrid ItemsSource="{Binding FilteredEvents}" RowHeight="46"><DataGrid.Columns><DataGridTextColumn Header="時間" Binding="{Binding TimeText}" Width="100"/><DataGridTextColumn Header="類別" Binding="{Binding Category}" Width="80"/><DataGridTextColumn Header="內容" Binding="{Binding Message}" Width="*" MinWidth="600"/></DataGrid.Columns></DataGrid></Border>
 </Grid>
</UserControl>
