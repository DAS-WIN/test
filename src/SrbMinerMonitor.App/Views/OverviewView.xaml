<UserControl x:Class="SrbMinerMonitor.App.Views.OverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:SrbMinerMonitor.App.Controls">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,8,14">
   <DockPanel Margin="0,0,0,16">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="▶ 開始" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
     <Button x:Name="StopMinerButton" Content="■ 停止礦工" ToolTip="只停止挖礦程序，監控視窗保持開啟" Command="{Binding StopCommand}" Foreground="#E99797" BorderBrush="#784A53" Background="Transparent" Margin="0,0,8,0"/>
     <Button x:Name="RestartMinerButton" Content="↻ 重啟礦工" ToolTip="只重啟挖礦程序，監控視窗保持開啟" Command="{Binding RestartCommand}" Margin="0,0,8,0"/>
     <Button Content="◷ 自動重啟礦工" Command="{Binding ScheduleCommand}" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
     <Button Content="⚙ 設定" Command="{Binding SettingsCommand}"/>
    </StackPanel>
    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}"><Run Text="運行時間  "/><Run Text="{Binding Uptime, Mode=OneWay}"/></TextBlock>
   </DockPanel>
   <TextBlock Text="{Binding HashrateUpdate, StringFormat=硬體資訊更新時間：{0}}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding ApiStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
   <Border Background="#182D38" BorderBrush="#284A5C" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,18">
    <DockPanel><TextBlock Text="{Binding ScheduleDetail}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource AccentBrush}" FontSize="12"/></DockPanel>
   </Border>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel>
    <TextBlock x:Name="RecentSharesHeading" Text="最近成功分享" Style="{StaticResource SectionTitle}"/>
    <ItemsControl ItemsSource="{Binding RecentShares}"><ItemsControl.ItemTemplate><DataTemplate>
     <TextBlock Text="{Binding Message}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,4"/>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
   <UniformGrid x:Name="SummaryCards" Columns="4" Margin="0,0,-12,18">
    <Border Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="總算力" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Hashrate}" Foreground="{StaticResource AccentBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding MetricRefreshSummary}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="GPU 總功耗" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Power}" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="顯卡感測值 · 非整機耗電" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="整體效率" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Efficiency}" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,15,0,9"/><TextBlock Text="總算力 ÷ GPU 總功耗" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="最高溫度" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Temperature}" Foreground="{StaticResource WarningBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="已提供溫度的 GPU" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
   </UniformGrid>
   <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,18">
    <StackPanel>
     <DockPanel Margin="20,16,20,14"><Button DockPanel.Dock="Right" Content="全部 GPU" Command="{Binding AllGpusCommand}" Padding="10,5" FontSize="11"/><TextBlock DockPanel.Dock="Right" Text="{Binding GpuCount}" Style="{StaticResource Muted}" Margin="0,0,14,0"/><TextBlock Text="顯卡即時狀態" FontSize="15" FontWeight="SemiBold"/></DockPanel>
     <DataGrid ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" MinHeight="90" MaxHeight="280" ScrollViewer.HorizontalScrollBarVisibility="Auto" FrozenColumnCount="2">
      <DataGrid.Columns>
       <DataGridTextColumn Header="GPU" Binding="{Binding Id}" Width="70"/>
       <DataGridTextColumn Header="型號" Binding="{Binding Name}" Width="*" MinWidth="190"/>
       <DataGridTextColumn Header="Hashrate" Binding="{Binding Hashrate}" Width="120"/>
       <DataGridTextColumn Header="Power" Binding="{Binding Power}" Width="90"/>
       <DataGridTextColumn Header="Eff" Binding="{Binding Efficiency}" Width="140"/>
       <DataGridTextColumn Header="Fan" Binding="{Binding Fan}" Width="65"/>
       <DataGridTextColumn Header="Temp" Binding="{Binding Temperature}" Width="75"/>
       <DataGridTextColumn Header="核心頻率" Binding="{Binding Core}" Width="100"/>
       <DataGridTextColumn Header="顯存頻率" Binding="{Binding Memory}" Width="110"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14,20,16">
      <StackPanel><TextBlock Text="{Binding ShareTitle}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
       <UniformGrid Columns="6">
        <StackPanel><TextBlock Text="成功 Accepted" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Accepted}" Foreground="{StaticResource SuccessBrush}" FontSize="23" Margin="0,5,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="Rejected" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Rejected}" Foreground="#E18C94" FontSize="23" Margin="0,5,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="Stale" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Stale}" Foreground="{StaticResource WarningBrush}" FontSize="23" Margin="0,5,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="Timeout" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Timeout}" Foreground="{StaticResource WarningBrush}" FontSize="23" Margin="0,5,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="HW errors" Style="{StaticResource Muted}"/><TextBlock Text="{Binding HardwareErrors}" FontSize="23" Margin="0,5,0,0"/></StackPanel>
        <StackPanel ToolTip="接受率 = Accepted ÷ (Accepted + Rejected)。Stale 不另行重複累加。"><TextBlock Text="接受率 ⓘ" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Acceptance}" Foreground="{StaticResource SuccessBrush}" FontSize="23" Margin="0,5,0,0"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="— 表示來源未提供。單卡分享使用總計；多卡從礦工輸出取得每卡統計，API 與輸出不重複加總。" Style="{StaticResource Muted}" FontSize="10" Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Border>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <DockPanel><ComboBox DockPanel.Dock="Right" Width="95" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}"/><ComboBox DockPanel.Dock="Right" Width="80" Margin="0,0,8,0" ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}"/><TextBlock Text="效能趨勢" FontSize="15" FontWeight="SemiBold"/></DockPanel>
      <controls:TrendChart Samples="{Binding ChartSamples}" MaxGapSeconds="{Binding ChartMaxGapSeconds}" Unit="{Binding ChartUnit}" Height="190" Margin="0,15,0,0"/>
      <UniformGrid Columns="4" Margin="0,10,0,0">
       <StackPanel><TextBlock Text="1 分鐘平均" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Average1m}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
       <StackPanel><TextBlock Text="15 分鐘平均" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Average15m}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
       <StackPanel><TextBlock Text="1 小時平均" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Average1h}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
       <StackPanel><TextBlock Text="6 小時平均" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Average6h}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="顯示實際涵蓋時間；斷線與重啟階段之間不連線。" Style="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel>
     <TextBlock Text="挖礦礦池" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="{Binding Pool}" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
     <TextBlock Text="{Binding PoolSource}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><Expander Header="礦工即時輸出（最近 500 行）" IsExpanded="False">
    <TextBox Text="{Binding MinerOutputText, Mode=OneWay}" TextChanged="OnMinerOutputChanged" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
   </Expander></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
